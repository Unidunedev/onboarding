// Configuração do deploy na Cloudflare (Workers com arquivos estáticos).
// O build gera a pasta dist/; "single-page-application" faz /mural e /desafio-pr
// abrirem o index.html, e o roteador do React cuida do resto.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onboarding",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
