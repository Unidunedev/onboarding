// Deploy do site de estudos na Cloudflare (um segundo Worker, ligado ao mesmo repositório).
// Build command:  npm run build:estudos
// Deploy command: npx wrangler deploy -c wrangler.estudos.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estudos",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./dist-estudos",
    "not_found_handling": "single-page-application",
  },
}
